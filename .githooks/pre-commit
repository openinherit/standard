#!/usr/bin/env bash
# INHERIT pre-commit safety hook
# Catches accidental commits of secrets, build artefacts, and large files.
# Wired to run via .husky/pre-commit — no manual `core.hooksPath` install
# needed. CI is the non-bypassable backstop.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

BLOCKED=0

# Get list of staged files (added, copied, modified, renamed)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# --- 1. Block build artefacts and editor config ---
BLOCKED_PATTERNS=(
  "^\.next/"
  "^\.vercel/"
  "^\.cursor/"
  "^\.vscode/"
  "^\.idea/"
  "^\.superpowers/"
  "^\.playwright-mcp/"
  "^node_modules/"
  "^\.docusaurus/"
  "^\.cache-loader/"
  "^build/"
)

for file in $STAGED_FILES; do
  for pattern in "${BLOCKED_PATTERNS[@]}"; do
    if echo "$file" | grep -qE "$pattern"; then
      echo -e "${RED}BLOCKED:${NC} $file matches blocked pattern ${pattern}"
      BLOCKED=1
    fi
  done
done

# --- 2. Block files that look like secrets ---
SECRET_PATTERNS=(
  '\.env$'
  '\.env\.'
  '\.pem$'
  '\.key$'
  '\.p12$'
  '\.pfx$'
  '\.jks$'
  'credentials\.json'
  'service-account.*\.json'
  'secret'
  'token\.json'
  '\.npmrc$'
)

for file in $STAGED_FILES; do
  basename=$(basename "$file")
  for pattern in "${SECRET_PATTERNS[@]}"; do
    if echo "$basename" | grep -qiE "$pattern"; then
      echo -e "${RED}BLOCKED:${NC} $file looks like a secret (matched: ${pattern})"
      BLOCKED=1
    fi
  done
done

# --- 3. Check staged file contents for hardcoded secrets ---
SECRET_CONTENT_PATTERNS=(
  'ANTHROPIC_API_KEY\s*=\s*sk-ant-'
  'OPENAI_API_KEY\s*=\s*sk-'
  'SUPABASE_SERVICE_ROLE_KEY\s*=\s*ey'
  'STRIPE_SECRET_KEY\s*=\s*sk_'
  'PRIVATE_KEY\s*=\s*-----BEGIN'
  'password\s*=\s*["\x27][^"\x27]{8,}'
)

for file in $STAGED_FILES; do
  # Skip binary files
  if file "$file" 2>/dev/null | grep -q "binary"; then
    continue
  fi
  # Only check content of files that exist on disk
  if [ -f "$file" ]; then
    for pattern in "${SECRET_CONTENT_PATTERNS[@]}"; do
      if git diff --cached -- "$file" | grep -qE "^\+.*$pattern" 2>/dev/null; then
        echo -e "${RED}BLOCKED:${NC} $file appears to contain a hardcoded secret (matched: ${pattern})"
        BLOCKED=1
      fi
    done
  fi
done

# --- 4. Warn on large files (>500KB) ---
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    size=$(wc -c < "$file")
    if [ "$size" -gt 512000 ]; then
      size_kb=$((size / 1024))
      echo -e "${YELLOW}WARNING:${NC} $file is ${size_kb}KB — are you sure this belongs in git?"
      # Warn but don't block — some large files are legitimate
    fi
  fi
done

# --- Result ---
if [ "$BLOCKED" -ne 0 ]; then
  echo ""
  echo -e "${RED}Commit blocked.${NC} Fix the issues above, or if you're certain, bypass with: git commit --no-verify"
  exit 1
fi

exit 0
