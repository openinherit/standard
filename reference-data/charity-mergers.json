{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INHERIT Charity Mergers Registry",
  "description": "Reference data tracking charity mergers — enables executors to identify successor organisations when a named charity has merged",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "oldCharityNumber",
      "oldCharityName",
      "newCharityNumber",
      "newCharityName",
      "mergerDate",
      "jurisdiction"
    ],
    "properties": {
      "oldCharityNumber": {
        "type": "string"
      },
      "oldCharityName": {
        "type": "string"
      },
      "newCharityNumber": {
        "type": "string"
      },
      "newCharityName": {
        "type": "string"
      },
      "mergerDate": {
        "type": "string",
        "format": "date"
      },
      "jurisdiction": {
        "type": "string"
      }
    }
  }
}
