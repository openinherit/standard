// TT-626 unit-test fixture — self-contained copy of the standard's service-eligibility schema.
entity Professional {
  category: String,
};
entity ServiceRequest {
  serviceType: String,
  jurisdiction: String,
};
action OfferService appliesTo {
  principal: [Professional],
  resource: [ServiceRequest],
};
